#!/bin/bash

(

  create_real_file() {
    file=$1
    cp -fi $HOME/dotfiles/$file.sample $HOME/dotfiles/$file
  }

  symlink() {
    file=$1
    echo -e "Unlinking symlink if it exists"
    unlink $HOME/$file
    echo -e "Making symlink: ~/dotfiles/${file} -> ~/${file}"
    ln -s $HOME/dotfiles/$file $HOME/$file
  }

  symlink ".bash"
  symlink ".bash_profile"
  symlink ".bashrc"
  symlink ".tmux"
  symlink ".tmux.conf"
  symlink ".vim"
  symlink ".vim/.backups"

  create_real_file ".bashrc"
  create_real_file ".bash_profile"
  create_real_file ".tmux/theme.sh"
  create_real_file ".vim/vimrc"

  mkdir $HOME/dotfiles/.vim/backups

  # Neovim reads ~/.config/nvim/init.vim, which is ~/dotfiles/.vim/nvim/init.vim.
  mkdir -p $HOME/.config
  if [ -d $HOME/.config/nvim ] && [ ! -L $HOME/.config/nvim ]; then
    backup=$HOME/.config/nvim.bak.$(date +%Y%m%d%H%M%S)
    echo -e "Moving existing ~/.config/nvim to ${backup}"
    mv $HOME/.config/nvim $backup
  fi
  echo -e "Unlinking symlink if it exists"
  unlink $HOME/.config/nvim 2>/dev/null
  echo -e "Making symlink: ~/dotfiles/.vim/nvim -> ~/.config/nvim"
  ln -s $HOME/dotfiles/.vim/nvim $HOME/.config/nvim
)
