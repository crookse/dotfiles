" Export vim's current highlight groups so nvim can apply them exactly.
"
" Run from vim (not nvim), in your normal terminal/tmux, with your usual file open:
"     :source ~/.vim/nvim/export_highlights.vim
" Writes ~/.vim/nvim/vim_highlights.vim, which ~/.vim/nvim/init.vim sources in nvim.
" Re-run whenever you change the theme.

if has('nvim')
  echoerr 'export_highlights.vim must be run from vim, not nvim'
  finish
endif

let s:out = ['" Generated by export_highlights.vim from vim ' . v:version . ' on ' . strftime('%Y-%m-%d')
      \ . '. Do not edit; re-run the export instead.',
      \ 'let &background = ' . string(&background)]

for s:hl in hlget()
  let s:name = s:hl.name
  " Airline redraws its own groups on every mode change.
  if s:name =~# '^airline'
    continue
  endif
  if has_key(s:hl, 'linksto')
    call add(s:out, 'hi! link ' . s:name . ' ' . s:hl.linksto)
    continue
  endif
  call add(s:out, 'hi clear ' . s:name)
  let s:attrs = []
  if has_key(s:hl, 'cterm') && !empty(s:hl.cterm)
    call add(s:attrs, 'cterm=' . join(keys(filter(copy(s:hl.cterm), 'v:val')), ','))
  endif
  for s:key in ['ctermfg', 'ctermbg', 'ctermul']
    if has_key(s:hl, s:key)
      call add(s:attrs, s:key . '=' . s:hl[s:key])
    endif
  endfor
  if !empty(s:attrs)
    call add(s:out, 'hi ' . s:name . ' ' . join(s:attrs, ' '))
  endif
endfor

let s:file = expand('~/.vim/nvim/vim_highlights.vim')
call writefile(s:out, s:file)
echo 'Wrote ' . (len(s:out) - 2) . ' highlight entries to ' . s:file
